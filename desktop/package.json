{
  "name": "drivego-admin",
  "version": "0.1.0",
  "private": true,
  "description": "DriveGo desktop administration foundation",
  "author": "DriveGo",
  "main": "dist-electron/electron/main.cjs",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -s first \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http-get://127.0.0.1:5173 && electron .\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "npm run build:electron && node --test tests/*.test.cjs",
    "test:electron": "node --test tests/electron.smoke.cjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "start": "electron ."
  },
  "dependencies": {
    "dotenv": "^17.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.drivego.admin",
    "productName": "DriveGo Admin",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
